{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "belief.schema.json",
  "title": "Belief (SPEC 4.5)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base-header.schema.json"
    },
    {
      "$ref": "governed-header.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(BEL)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "source_concepts": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(BU)-[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "normal_baseline": {
          "type": "string",
          "pattern": "^(BU)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "watch_condition": {
          "type": "string",
          "minLength": 1
        },
        "evolution_trail": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "statement",
        "why_it_matters",
        "source_concepts",
        "normal_baseline",
        "watch_condition",
        "evolution_trail"
      ]
    }
  ],
  "unevaluatedProperties": false
}

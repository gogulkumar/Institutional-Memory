{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "record-artifact.schema.json",
  "title": "Record artifact (SPEC 4.3)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base-header.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(REC)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "business_area": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "pattern": "^\\d{4}(-Q[1-4]|-\\d{2}(-\\d{2})?)?$"
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "authority_rank": {
          "enum": [
            "expert_statement",
            "system_of_record",
            "published_deliverable",
            "working_file",
            "inference"
          ]
        }
      },
      "required": [
        "type",
        "business_area",
        "period",
        "event_ids",
        "version",
        "location",
        "authority_rank"
      ]
    }
  ],
  "unevaluatedProperties": false
}

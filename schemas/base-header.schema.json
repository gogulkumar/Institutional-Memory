{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "base-header.schema.json",
  "title": "Base header (every entry)",
  "type": "object",
  "required": [
    "id",
    "title",
    "recorded_at",
    "provenance",
    "sensitivity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(LENS|REC|BU|BEL|RP|ED)-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^(REC)-[0-9A-HJKMNP-TV-Z]{26}$"
          },
          {
            "type": "string",
            "pattern": "^expert:.+$"
          }
        ]
      }
    },
    "sensitivity": {
      "type": "string",
      "minLength": 1,
      "description": "A level from brain/config.yaml sensitivity_levels; never lower than the most restricted source in provenance"
    }
  }
}
